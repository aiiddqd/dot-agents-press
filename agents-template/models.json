{
  "default": {
    "provider": "openrouter",
    "model": "deepseek/deepseek-v4-pro",
    "temperature": 0.7,
    "max_tokens": 4096
  },
  "presets": {
    "fast": {
      "provider": "openrouter",
      "model": "openai/gpt-4o-mini",
      "temperature": 0.5,
      "max_tokens": 2048
    },
    "powerful": {
      "provider": "openrouter",
      "model": "anthropic/claude-sonnet-4-5",
      "temperature": 0.3,
      "max_tokens": 8192
    },
    "creative": {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 1.0,
      "max_tokens": 4096
    },
    "coding": {
      "provider": "openrouter",
      "model": "anthropic/claude-sonnet-4-5",
      "temperature": 0.1,
      "max_tokens": 8192
    }
  },
  "providers": {
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "api_key_constant": "OPENROUTER_API_KEY"
    },
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "DAP_OPENAI_API_KEY",
      "api_key_constant": "DAP_OPENAI_API_KEY"
    },
    "anthropic": {
      "api_key_env": "DAP_ANTHROPIC_API_KEY",
      "api_key_constant": "DAP_ANTHROPIC_API_KEY"
    }
  }
}
